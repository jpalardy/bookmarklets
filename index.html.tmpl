<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <link rel="stylesheet" href="/css/base.css" type="text/css" media="screen, projection" />
    <title>Bookmarklets</title>
    <style>
      body {
        padding-left: 20px;
        font-family: sans-serif;
        font-size: 90%;
        color: #555;
      }
      a {
        color: #777;
        font-weight: bold;
      }
    </style>
